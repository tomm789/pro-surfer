{
  "name": "line-up",
  "private": true,
  "version": "0.1.0",
  "description": "LINE-UP: an original 3D surf trick game for macOS (browser + native wrapper).",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "shot": "node tools/screenshot.mjs",
    "clip": "node tools/clip.mjs",
    "smoke": "node tools/smoke.mjs",
    "feel": "vitest run tests/feel.test.ts && node -e \"console.log(require('fs').readFileSync('artifacts/feel-report.json','utf8'))\"",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "three": "0.185.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "0.185.4",
    "playwright": "^1.56.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
